# Build stage
FROM node:18-alpine AS builder

# Accept build arguments
ARG BUILD_VERSION
ARG BUILD_TIMESTAMP
ARG VITE_API_BASE_URL
ARG VITE_APP_NAME
ARG VITE_APP_ENV

# Set environment variables for Vite build
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_APP_NAME=${VITE_APP_NAME} \
    VITE_APP_ENV=${VITE_APP_ENV}

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies for build)
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Accept build arguments
ARG BUILD_VERSION
ARG BUILD_TIMESTAMP

# Set environment variables for build info
ENV BUILD_VERSION=${BUILD_VERSION} \
    BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Copy built application
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY nginx.conf /etc/nginx/nginx.conf.template

    # Install envsubst (part of gettext package)
    RUN apk add --no-cache gettext-libs

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# Start script that substitutes environment variables and starts nginx
CMD /bin/sh -c "envsubst '\$BACKEND_URL' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && nginx -g 'daemon off;'"
